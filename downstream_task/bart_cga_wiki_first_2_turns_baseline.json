    "max_lr": 0.00002,
    "min_lr": 0.000002,
    "cycle_epochs": 15,
    "warmup_epochs": 0.5,
    "lr_gamma": 1.0,
    "grad_clip": 5.0,
    "flash_attn": true,
    "test_on_best_model": true,

    "num_epochs": 15,

    "dtype": "float32",
    "activation_checkpointing": false,

    "seed": 26403,
    "device": "cuda",
    "num_workers": 1,
    "tensorboard_log_dir": "./logs/",
    "use_amp": true,

    "do_sample": true,
    "temperature": 0.7,
    "top_p": 0.8,
