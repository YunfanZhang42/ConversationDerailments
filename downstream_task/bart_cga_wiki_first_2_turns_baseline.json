{
    "model_type": "facebook/bart-base",
    "model_name": "classifier-bart-cga-wiki-first-2-turns",
    "load_model": "",
    "load_classification_head": false,
    "saved_model_path": "./checkpoints/",

    "dataset_dir": "./data_collection/final_data/cga_wiki/",
    "train_filename": "train_circumplex_fixed.jsonl",
    "train_text_source": "real",
    "val_filename": "val_circumplex_fixed.jsonl",
    "val_text_source": "real",
    "test_filename": "test_circumplex_fixed.jsonl",
    "test_text_source": "real",
    "label_type": "toxic_label",
    "keep_first_turn": true,
